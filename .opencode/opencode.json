{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "*.json": "ask",
      ".github/workflows/*": "ask",
      "requirements.txt": "ask"
    },
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git add *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git reset --hard*": "deny",
      "git rebase*": "deny",
      "pip install *": "ask",
      "npm install*": "ask",
      "*": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
